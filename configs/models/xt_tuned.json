        {
          "bootstrap": [
            false
          ]
        },
        {
          "bootstrap": [
            false
          ],
          "max_features": [
            "log2",
            0.1,
            "sqrt",
            0.5
          ],
          "min_samples_leaf": [
            1,
            5
          ]
        }
      ]
    },
    "source_url": "https://github.com/scikit-learn/scikit-learn",
    "description": "This uses the same Extra Trees model as XT for classification or regression. A small predefined grid varies candidate features per split, minimum leaf size and bootstrap sampling on a training-only holdout, then the selected model is refitted on the full training fold."
